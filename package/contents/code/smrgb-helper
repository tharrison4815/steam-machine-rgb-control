#!/usr/bin/env python3
"""Steam Machine RGB Control - hardware helper.

Reads and writes the Steam Machine's front LED strip via the kernel's valve-leds
driver (/sys/class/leds/valve-leds[N]). Prints JSON on stdout. Standard library only.

  smrgb-helper state - [tag]          print current strip state, the design saved for Game Mode
                                     and the boot colour
  smrgb-helper apply '<json>' [tag]  apply any of: colours, effect, enabled, scale, delay,
                                     startup_colour, startup_scale; then print the new state
  smrgb-helper save '<json>' [tag]   save a design for Game Mode (closes Steam if it's running)

JSON fields (colours are in hardware index order: index 0 = rightmost LED):
  {"colours": [[r,g,b] x17], "effect": "manual", "enabled": 1, "scale": 9, "delay": 10}

Game Mode keeps its LED design in Steam's localconfig.vdf ("LEDManager") and re-applies it
whenever Steam starts. Steam rewrites that file on exit, so it must be closed while we edit it.
"""
import glob, json, math, os, re, shutil, subprocess, sys, tempfile, time

BASE = "/sys/class/leds"
EFFECTS = ("manual", "breath", "patrol", "rainbow")


def led_dirs():
    found = []
    for path in glob.glob(os.path.join(BASE, "valve-leds[[]*[]]")):
        m = re.search(r"\[(\d+)\]$", path)
        if m:
            found.append((int(m.group(1)), path))
    return [p for _, p in sorted(found)]


def read(path, attr):
    with open(os.path.join(path, attr)) as f:
        return f.read().strip()


def write(path, attr, value):
    with open(os.path.join(path, attr), "w") as f:
        f.write(str(value))


def as_int(text):
    return int(text, 0)  # sysfs mixes "9" and "0x09"


def state():
    leds = led_dirs()
    if not leds:
        return {"available": False, "error": "No valve-leds devices found. Is this a Steam Machine?"}
    first = leds[0]
    return {
        "available": True,
        "count": len(leds),
        "writable": os.access(os.path.join(first, "multi_intensity"), os.W_OK),
        "colours": [[int(v) for v in read(p, "multi_intensity").split()] for p in leds],
        "effect": read(first, "effect"),
        "enabled": as_int(read(first, "enabled")),
        "scale": as_int(read(first, "brightness_scale")),
        "delay": as_int(read(first, "delay")),
    }


def startup():
    leds = led_dirs()
    if not leds:
        return None
    try:
        return {
            "colour": [int(v) for v in read(leds[0], "multi_intensity_startup").split()],
            "scale": as_int(read(leds[0], "brightness_startup")),
        }
    except OSError:
        return None


def clamp(v, lo, hi):
    return max(lo, min(hi, int(v)))


def apply(changes):
    leds = led_dirs()
    if not leds:
        return state()
    # Order matters a little: set levels before colours, effect last.
    if "scale" in changes:
        for p in leds:
            write(p, "brightness_scale", clamp(changes["scale"], 0, 255))
    if "delay" in changes:
        for p in leds:
            write(p, "delay", clamp(changes["delay"], 0, 20))
    if "colours" in changes:
        cols = changes["colours"]
        if len(cols) != len(leds):
            raise ValueError(f"expected {len(leds)} colours, got {len(cols)}")
        for p, c in zip(leds, cols):
            write(p, "multi_intensity", " ".join(str(clamp(v, 0, 255)) for v in c))
    if "effect" in changes:
        if changes["effect"] not in EFFECTS:
            raise ValueError(f"unknown effect {changes['effect']!r}")
        for p in leds:
            write(p, "effect", changes["effect"])
    if "enabled" in changes:
        for p in leds:
            write(p, "enabled", 1 if changes["enabled"] else 0)
    if "startup_colour" in changes:
        c = changes["startup_colour"]
        for p in leds:
            write(p, "multi_intensity_startup", " ".join(str(clamp(v, 0, 255)) for v in c))
    if "startup_scale" in changes:
        for p in leds:
            write(p, "brightness_startup", clamp(changes["startup_scale"], 0, 255))
    return state()


# ---------------------------------------------------------------- Steam / Game Mode

CONFIG_GLOB = os.path.expanduser("~/.local/share/Steam/userdata/*/config/localconfig.vdf")
BACKUPS_KEPT = 5


# Steam stores colours as 0..1 floats and converts them (measured on the device):
#   v >= 0.95 -> 255, otherwise q = round(v*255), level = floor(255 * (q/255)^2.2)
def steam_to_level(v):
    if v >= 0.95:
        return 255
    q = math.floor(v * 255 + 0.5)
    return math.floor(255 * (q / 255) ** 2.2)


# Every level Steam can produce, with the stored string that produces it (lowest q first).
REACHABLE = {}
for _q in range(0, 243):           # q/255 < 0.95  <=>  q <= 242
    REACHABLE.setdefault(steam_to_level(_q / 255), f"{_q / 255:.6f}")
REACHABLE[255] = "1"


def level_to_steam(level):
    """Nearest level Game Mode can reproduce, and the string to store for it."""
    best = min(REACHABLE, key=lambda r: (abs(r - level), r))
    return best, REACHABLE[best]


def scale_to_brightness(scale):
    # Steam: brightness_scale = floor(255 * B^2.2). Aim for the middle of the step.
    if scale >= 255:
        return "1"
    if scale <= 0:
        return "0"
    return f"{((scale + 0.5) / 255) ** (1 / 2.2):.6f}"


def find_block(text, name, start=0):
    """(open_brace, close_brace) indices of the block "name" { ... } at or after start."""
    m = re.compile(r'"%s"\s*\{' % re.escape(name)).search(text, start)
    if not m:
        return None
    open_i = m.end() - 1
    depth = 0
    for j in range(open_i, len(text)):
        if text[j] == "{":
            depth += 1
        elif text[j] == "}":
            depth -= 1
            if depth == 0:
                return open_i, j
    raise ValueError(f"unbalanced braces in the {name} block")


def child_blocks(text, o, c):
    """Direct child blocks of the block spanning text[o..c]: [(name, open, close)]."""
    out, pos = [], o + 1
    pat = re.compile(r'"([^"]*)"\s*(\{|"[^"]*")')
    while True:
        m = pat.search(text, pos, c)
        if not m:
            return out
        if m.group(2) == "{":
            bo, bc = find_block(text, m.group(1), m.start())
            out.append((m.group(1), bo, bc))
            pos = bc + 1
        else:
            pos = m.end()


def get_key(body, key):
    m = re.search(r'"%s"\s+"([^"]*)"' % re.escape(key), body)
    return m.group(1) if m else None


def set_key(body, key, value, indent):
    """Set "key" "value" in a block body (outside nested blocks), adding it if missing."""
    pat = re.compile(r'("%s"\s+)"[^"]*"' % re.escape(key))
    if pat.search(body):
        return pat.sub(lambda m: f'{m.group(1)}"{value}"', body, count=1)
    return body.rstrip("\t") + f'{indent}"{key}"\t\t"{value}"\n' + indent[:-1]


def profiles(text):
    """LEDManager device profiles: [(name, open, close)]."""
    mgr = find_block(text, "LEDManager")
    return child_blocks(text, *mgr) if mgr else []


def read_profile(body):
    cols = []
    for i in range(int(get_key(body, "ColorCount") or 0)):
        blk = find_block(body, str(i))
        if not blk:
            return None
        inner = body[blk[0]:blk[1]]
        cols.append([steam_to_level(float(get_key(inner, ch) or 0)) for ch in "RGB"])
    b = float(get_key(body, "Brightness") or 1)
    speed = float(get_key(body, "Speed") or 0.5)
    return {
        "colours": cols,
        "effect": get_key(body, "Effect") or "manual",
        "enabled": int(get_key(body, "Enabled") or 1),
        "scale": math.floor(255 * b ** 2.2 + 1e-6),
        "delay": round(20 * (1 - speed)),
    }


def saved_design():
    """The design Game Mode will restore, as hardware values, or an explanation."""
    files = sorted(glob.glob(CONFIG_GLOB))
    if not files:
        return {"available": False, "reason": "Steam's settings file wasn't found. Has Steam been set up?"}
    for path in files:
        try:
            text = open(path, encoding="utf-8").read()
            for _name, o, c in profiles(text):
                d = read_profile(text[o + 1:c])
                if d and d["colours"]:
                    d["available"] = True
                    return d
        except (OSError, ValueError):
            continue
    return {"available": False,
            "reason": "Steam has no saved light settings yet. Change the Front Lights once in "
                      "Game Mode (Settings > Customization), then try again."}


def rewrite_profile(body, design):
    cols = design["colours"]
    if int(get_key(body, "ColorCount") or 0) != len(cols):
        raise ValueError("Steam's saved design has a different number of LEDs")
    for i, rgb in enumerate(cols):
        o, c = find_block(body, str(i))
        inner = body[o + 1:c]
        for ch, level in zip("RGB", rgb):
            inner, n = re.subn(r'("%s"\s+)"[^"]*"' % ch,
                               lambda m, v=level_to_steam(level)[1]: f'{m.group(1)}"{v}"', inner)
            if n != 1:
                raise ValueError(f"colour slot {i} is missing its {ch} value")
        body = body[:o + 1] + inner + body[c:]
    ind = "\t\t\t"
    body = set_key(body, "Brightness", scale_to_brightness(design["scale"]), ind)
    body = set_key(body, "Enabled", "1" if design.get("enabled", 1) else "0", ind)
    body = set_key(body, "Effect", design["effect"], ind)
    body = set_key(body, "Speed", f"{1 - clamp(design['delay'], 0, 20) / 20:.6f}", ind)
    return body


def set_separate_colours(text):
    """Turn on Steam's "separate colours" option (Valve spells the key SeparaeLEDColors)."""
    blk = find_block(text, "SteamOS")
    if blk:
        o, c = blk
        return text[:o + 1] + set_key(text[o + 1:c], "SeparaeLEDColors", "1", "\t\t") + text[c:]
    mgr = find_block(text, "LEDManager")
    insert = mgr[1] + 1
    return text[:insert] + '\n\t"SteamOS"\n\t{\n\t\t"SeparaeLEDColors"\t\t"1"\n\t}' + text[insert:]


def proc_running(args):
    return subprocess.run(["pgrep"] + args, capture_output=True).returncode == 0


def steam_running():
    return proc_running(["-x", "steam"])


def game_running():
    # Games started by Steam run under its "reaper" process. [r] stops pgrep matching itself.
    return proc_running(["-f", "[r]eaper SteamLaunch"])


def close_steam(files, timeout=90, settle=2.0):
    subprocess.Popen(["steam", "-shutdown"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)
    end = time.time() + timeout
    while steam_running():
        if time.time() > end:
            raise RuntimeError(f"Steam didn't close within {timeout} seconds. Nothing was changed.")
        time.sleep(0.5)
    # Steam writes its config while shutting down: wait until the files stop changing.
    last, stable_since = None, time.time()
    while time.time() - stable_since < settle:
        cur = [os.stat(f).st_mtime_ns for f in files]
        if cur != last:
            last, stable_since = cur, time.time()
        time.sleep(0.25)


def atomic_write(path, data):
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".localconfig.", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        shutil.copymode(path, tmp)
        os.replace(tmp, path)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def prune_backups(path):
    old = sorted(glob.glob(path + ".smrgb-backup-*"))
    for f in old[:-BACKUPS_KEPT]:
        os.unlink(f)


def save(design):
    cols = design["colours"]
    if not cols or any(len(c) != 3 for c in cols):
        raise ValueError("no colours to save")
    if design["effect"] not in EFFECTS:
        raise ValueError(f"unknown effect {design['effect']!r}")
    files = sorted(glob.glob(CONFIG_GLOB))
    current = saved_design()
    if not current["available"]:
        raise RuntimeError(current["reason"])
    if game_running():
        raise RuntimeError("A game is running. Close it, then save again. Nothing was changed.")

    was_running = steam_running()
    if was_running:
        close_steam(files)

    separate = any(c != cols[0] for c in cols)
    backups = []
    for path in files:
        text = open(path, encoding="utf-8").read()
        profs = profiles(text)
        if not profs:
            continue                      # another Steam account that never set the lights
        new = text
        for _name, o, c in reversed(profs):   # back to front so indices stay valid
            new = new[:o + 1] + rewrite_profile(new[o + 1:c], design) + new[c:]
        if separate:
            new = set_separate_colours(new)
        if new.count("{") != new.count("}"):
            raise RuntimeError("Internal error: the edited settings would be malformed. Nothing was changed.")
        backup = f"{path}.smrgb-backup-{time.strftime('%Y%m%d-%H%M%S')}"
        shutil.copy2(path, backup)
        atomic_write(path, new)
        check = open(path, encoding="utf-8").read()
        if check != new:
            shutil.copy2(backup, path)
            raise RuntimeError("The settings file didn't save correctly, so the backup was restored.")
        prune_backups(path)
        backups.append(backup)

    saved = saved_design()
    expected = [[level_to_steam(v)[0] for v in c] for c in cols]
    if saved.get("colours") != expected:
        raise RuntimeError("Saved, but reading it back gave different colours. Backups: " + ", ".join(backups))
    return {"saved": saved, "steamWasRunning": was_running, "backups": backups}


def main():
    try:
        cmd = sys.argv[1] if len(sys.argv) > 1 else "state"
        if cmd == "state":
            out = state()
            if out.get("available"):
                out["saved"] = saved_design()
                out["startup"] = startup()
                out["steamRunning"] = steam_running()
        elif cmd == "apply":
            out = apply(json.loads(sys.argv[2]))
        elif cmd == "save":
            out = save(json.loads(sys.argv[2]))
        else:
            raise ValueError(f"unknown command {cmd!r}")
        out["ok"] = True
    except Exception as e:  # report errors as JSON so the UI can show them
        out = {"ok": False, "error": f"{type(e).__name__}: {e}"}
    if len(sys.argv) > 3:
        out["tag"] = sys.argv[3]
    print(json.dumps(out))


if __name__ == "__main__":
    main()
